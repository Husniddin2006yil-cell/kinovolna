# Скопируйте в .env локально; в production задайте secrets в панели хостинга.
# Никогда не размещайте секреты в VITE_*, frontend или GitHub.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
# 0 = to‘g‘ridan-to‘g‘ri; 1 = faqat bitta ishonchli HTTPS proxy ortida.
TRUST_PROXY_HOPS=0
DATABASE_URL=
# Faqat Docker Compose uchun: POSTGRES_PASSWORD va DOCKER_DATABASE_URL.
POSTGRES_PASSWORD=
DOCKER_DATABASE_URL=

# Server Telegram Bot API — hech qachon GitHub’ga commit qilmang.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_INVITE_URL=
TELEGRAM_INIT_DATA_MAX_AGE=3600
PUBLIC_BASE_URL=
# Published Mini App uchun haqiqiy HTTPS URL. Placeholder ishlatilmaydi.
MINI_APP_URL=

# Saqlangan media sozlamalari.
MEDIA_STORAGE_BASE_URL=
AUDIO_RECOGNITION_API_KEY=
YOUTUBE_API_KEY=
TMDB_API_KEY=

# Faqat public API URL; bo‘sh bo‘lsa dev proxy ishlaydi.
VITE_API_BASE_URL=
# Compatibility only; film linklarini endi backend beradi.
VITE_TELEGRAM_BOT_USERNAME=
