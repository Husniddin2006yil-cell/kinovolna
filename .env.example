# Скопируйте в .env локально; в production задайте secrets в панели хостинга.
# Никогда не размещайте секреты в VITE_*, frontend или GitHub.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
# 0 = to‘g‘ridan-to‘g‘ri; 1 = faqat bitta ishonchli HTTPS proxy ortida.
# Proxy request headerlarini qayta yozishi va app porti tashqaridan yopiq bo‘lishi shart.
TRUST_PROXY_HOPS=0
DATABASE_URL=
# Faqat Docker Compose uchun: POSTGRES_PASSWORD va DOCKER_DATABASE_URL.
# DOCKER_DATABASE_URL format: postgres://kinovolna:<URL-encoded-password>@db:5432/kinovolna
POSTGRES_PASSWORD=
DOCKER_DATABASE_URL=

# Серверный Telegram Bot API — заполнить своими данными.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_INVITE_URL=
TELEGRAM_INIT_DATA_MAX_AGE=3600
PUBLIC_BASE_URL=
MINI_APP_URL=

# Сохранённые настройки будущих медиаисточников (на этом этапе не используются).
MEDIA_STORAGE_BASE_URL=
AUDIO_RECOGNITION_API_KEY=

# Только публичный URL API. Пусто = тот же origin, в dev Vite proxy -> port3001.
VITE_API_BASE_URL=
# Сохранено для совместимости: ссылки фильмов теперь выдаёт backend, не это поле.
VITE_TELEGRAM_BOT_USERNAME=
