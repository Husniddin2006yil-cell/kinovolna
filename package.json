{
  "name": "turbomedia",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "bot:start": "node bot/index.mjs",
    "bot:check": "node --check bot/index.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "tmdb:sync": "node scripts/tmdb-sync.mjs",
    "telegram:check": "node scripts/telegram-setup.mjs check",
    "telegram:webhook": "node scripts/telegram-setup.mjs webhook",
    "telegram:menu": "node scripts/telegram-setup.mjs menu",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
